<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Editar Producto</title>
      <!-- Favicon -->
    <link rel="icon" type="image/png" href="/img/favicon.png">

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css"
        rel="stylesheet">

    <link rel="stylesheet" href="/css/estilos.css">
</head>

<body>
        <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">

        <div class="container">
            

            <a class="navbar-brand d-flex align-items-center" href="#">
                <img src="/img/bookflix_logo.png"
                     alt="Logo"
                     width="40"
                     class="me-2">

                Bookflix - Tienda de libros y peliculas by Colomer & Quirico
            </a>

            <button
                class="navbar-toggler"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#menu">

                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="menu">

                <ul class="navbar-nav ms-auto">

                    <li class="nav-item">

                    </li>

                </ul>

            </div>

        </div>

    </nav>

<div class="container py-5">

    <div class="mb-4">

        <a
            href="/admin/productos"
            class="btn btn-outline-secondary">

            ← Volver al listado

        </a>

    </div>

    <div class="row justify-content-center">
        <input type="hidden" name="pagina" value="<%= pagina %>">

        <div class="col-md-8 col-lg-7">

            <div class="card shadow-lg border-0 rounded-4">

                <div class="card-body p-5">

                    <h1 class="text-center mb-2">
                        Editar Producto
                    </h1>

                    <p class="text-danger small mb-4">
                        * Todos los campos son obligatorios excepto la imagen.
                    </p>

                    <form
                        id="formEditarProducto"
                        action="/admin/productos/editar/<%= producto.id %>"
                        method="POST"
                        enctype="multipart/form-data">
                        <input
                        type="hidden"
                        name="pagina"
                        value="<%= pagina %>">

                        <div class="mb-3">

                            <label class="form-label">
                                Nombre <span class="text-danger">*</span>
                            </label>

                            <input
                                type="text"
                                name="nombre"
                                maxlength="100"
                                class="form-control"
                                value="<%= producto.nombre %>"
                                required>

                            <div class="form-text">
                                Máximo 100 caracteres.
                            </div>

                        </div>

                        <div class="mb-3">

                            <label class="form-label">
                                Descripción <span class="text-danger">*</span>
                            </label>

                            <textarea
                                name="descripcion"
                                class="form-control"
                                rows="4"
                                maxlength="500"
                                required><%= producto.descripcion %></textarea>

                            <div class="form-text">
                                Máximo 500 caracteres.
                            </div>

                        </div>

                        <div class="mb-3">

                            <label class="form-label">
                                Precio <span class="text-danger">*</span>
                            </label>

                            <input
                                type="number"
                                step="0.01"
                                min="0"
                                name="precio"
                                class="form-control"
                                value="<%= producto.precio %>"
                                required>

                            <div class="form-text">
                                Debe ser un valor mayor o igual a 0.
                            </div>

                        </div>

                        <div class="mb-3">

                            <label class="form-label">
                                Imagen actual
                            </label>

                            <div class="text-center mb-3">

                                <img
                                    src="/uploads/<%= producto.imagen %>"
                                    alt="<%= producto.nombre %>"
                                    class="img-thumbnail"
                                    style="max-width: 200px;">

                            </div>

                            <label class="form-label">
                                Nueva imagen (opcional)
                            </label>

                            <input
                                type="file"
                                name="imagen"
                                class="form-control"
                                accept="image/*">

                            <div class="form-text">
                                Deje este campo vacío para conservar la imagen actual.
                            </div>

                        </div>

                        <div class="mb-3">

                            <label class="form-label">
                                Categoría <span class="text-danger">*</span>
                            </label>

                            <select
                                name="categoria"
                                class="form-select"
                                required>

                                <option
                                    value="Libro"
                                    <%= producto.categoria === "Libro" ? "selected" : "" %>>
                                    Libro
                                </option>

                                <option
                                    value="Pelicula"
                                    <%= producto.categoria === "Pelicula" ? "selected" : "" %>>
                                    Película
                                </option>

                            </select>

                        </div>

                        <div class="mb-4">

                            <label class="form-label">
                                Género <span class="text-danger">*</span>
                            </label>

                            <input
                                type="text"
                                name="genero"
                                maxlength="50"
                                class="form-control"
                                value="<%= producto.genero %>"
                                required>

                            <div class="form-text">
                                Máximo 50 caracteres.
                            </div>

                        </div>

                        <button
                            type="button"
                            class="btn btn-primary btn-lg w-100"
                            onclick="validarYMostrarModal()">

                            Guardar Cambios

                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

<!-- MODAL CONFIRMACION -->

<div
    class="modal fade"
    id="modalEditar"
    tabindex="-1">

    <div class="modal-dialog">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">
                    Confirmar modificación
                </h5>

                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="modal">
                </button>

            </div>

            <div class="modal-body">

                ¿Está seguro de que desea guardar los cambios realizados?

            </div>

            <div class="modal-footer">

                <button
                    type="button"
                    class="btn btn-secondary"
                    data-bs-dismiss="modal">

                    Cancelar

                </button>

                <button
                    type="button"
                    class="btn btn-primary"
                    onclick="enviarFormularioEdicion()">

                    Guardar

                </button>

            </div>

        </div>

    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>

<script>

    function validarYMostrarModal() {

        const formulario =
            document.getElementById("formEditarProducto");

        if (formulario.checkValidity()) {

            const modal = new bootstrap.Modal(
                document.getElementById("modalEditar")
            );

            modal.show();

        } else {

            formulario.reportValidity();

        }

    }

    function enviarFormularioEdicion() {

        document
            .getElementById("formEditarProducto")
            .submit();

    }

</script>

</body>
</html>