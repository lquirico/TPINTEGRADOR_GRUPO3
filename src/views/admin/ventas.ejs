<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Ventas</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css"
        rel="stylesheet">

</head>

<body>

<div class="container py-5">

    <h1 class="mb-4">
        Listado de Ventas
    </h1>
        <div class="mb-4">

        <a
            href="/admin/productos"
            class="btn btn-outline-secondary">

            ← Volver al listado

        </a>

    </div>

    <div id="contenedorVentas">

        <p>Cargando ventas...</p>

    </div>

</div>

<script>

async function cargarVentas() {

    try {

        const respuesta =
            await fetch("/api/ventas");

        const resultado =
            await respuesta.json();

        const contenedor =
            document.getElementById("contenedorVentas");

        contenedor.innerHTML = "";

        resultado.data.forEach(venta => {

            let productosHtml = "";

            venta.productos.forEach(producto => {

                productosHtml += `

                    <tr>

                        <td>
                            ${producto.nombre}
                        </td>

                        <td>
                            ${producto.Venta_productos.cantidad}
                        </td>

                        <td>
                            $${producto.precio}
                        </td>

                    </tr>

                `;

            });

            contenedor.innerHTML += `

                <div class="card mb-4 shadow">

                    <div class="card-header">

                        <strong>
                            Venta #${venta.id}
                        </strong>

                    </div>

                    <div class="card-body">

                        <p>
                            <strong>Cliente:</strong>
                            ${venta.cliente_nombre}
                        </p>

                        <p>
                            <strong>Fecha:</strong>
                            ${new Date(venta.fecha).toLocaleDateString("es-AR")}
                        </p>

                        <p>
                            <strong>Total:</strong>
                            $${venta.total}
                        </p>

                        <h5 class="mt-4">
                            Productos
                        </h5>

                        <table class="table table-striped">

                            <thead>

                                <tr>

                                    <th>Producto</th>
                                    <th>Cantidad</th>
                                    <th>Precio</th>

                                </tr>

                            </thead>

                            <tbody>

                                ${productosHtml}

                            </tbody>

                        </table>

                    </div>

                </div>

            `;

        });

    } catch (error) {

        console.error(error);

        document.getElementById(
            "contenedorVentas"
        ).innerHTML =
            "<p>Error al cargar ventas</p>";

    }

}

cargarVentas();

</script>

</body>

</html>