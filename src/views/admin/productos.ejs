<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Dashboard de Productos</title>

    <link rel="icon" type="image/png" href="/img/favicon.png">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/estilos.css">

</head>

<body>

<!-- NAVBAR -->
<nav class="navbar navbar-expand-lg navbar-dark bg-dark">

    <div class="container">

        <a class="navbar-brand d-flex align-items-center" href="#">
            <img src="/img/bookflix_logo.png" alt="Logo" width="40" class="me-2">
            Bookflix - Tienda de libros y peliculas by Colomer & Quirico
        </a>

    </div>

</nav>

<div class="container py-5">

    <div class="pagina-header">

        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">

            <div>
                <h1>Listado de Productos</h1>
                <p class="text-muted">Aldana Colomer - Lucia Quirico</p>
            </div>

            <div class="mb-3">
                <label class="form-label">Filtrar por tipo:</label>

                <select id="filtroCategoria" class="form-select">
                    <option value="Todos">Todos</option>
                    <option value="Libro">Libros</option>
                    <option value="Pelicula">Peliculas</option>
                </select>
            </div>

            <a href="/logout" class="btn btn-outline-secondary">Cerrar sesion</a>
            <a href="/admin/productos/nuevo" class="btn btn-primary">Nuevo Producto</a>
            <a href="/admin/ventas" class="btn btn-info">Ver Ventas</a>
        </div>

    </div>

    <div id="contenedorProductos">
        <p>Cargando productos...</p>
    </div>

    <nav class="mt-4">
        <ul id="paginacion" class="pagination justify-content-center"></ul>
    </nav>

</div>

<!-- MODAL -->
<div class="modal fade" id="modalConfirmar" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Confirmación</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body" id="modalTexto">
                ¿Estás seguro?
            </div>

            <div class="modal-footer">

                <button class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>

                <form id="formAccion" method="POST">
                    <button type="submit" class="btn btn-danger">Confirmar</button>
                </form>

            </div>

        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>

<script>

function getParams() {
    const params = new URLSearchParams(window.location.search);
    return {
        pagina: parseInt(params.get("pagina")) || 1,
        categoria: params.get("categoria") || "Todos"
    };
}

function actualizarURL(pagina, categoria) {
    const url = new URL(window.location);

    url.searchParams.set("pagina", pagina);
    url.searchParams.set("categoria", categoria);

    window.history.pushState({}, "", url);
}

let paginaActual = getParams().pagina;

document.getElementById("filtroCategoria").value = getParams().categoria;

async function cargarProductos(pagina = paginaActual) {

    try {

        const categoria = document.getElementById("filtroCategoria").value;

        paginaActual = pagina;

        actualizarURL(paginaActual, categoria);

        let url = `/api/productos?pagina=${paginaActual}&categoria=${categoria}`;

        const respuesta = await fetch(url);
        const resultado = await respuesta.json();

        const contenedor = document.getElementById("contenedorProductos");
        contenedor.innerHTML = "";

        resultado.data.forEach(producto => {

            contenedor.innerHTML += `
                <div class="producto-card">

                    <div class="row align-items-center">

                        <div class="col-md-3 text-center">
                            <img src="/uploads/${producto.imagen}"
                                 alt="${producto.nombre}"
                                 class="producto-imagen">
                        </div>

                        <div class="col-md-9">

                            <h3>${producto.nombre}</h3>

                            <p><strong>Categoria:</strong> ${producto.categoria}</p>
                            <p><strong>Descripcion:</strong> ${producto.descripcion}</p>
                            <p><strong>Genero:</strong> ${producto.genero}</p>
                            <p><strong>Precio:</strong> $${producto.precio}</p>
                            <p><strong>Estado:</strong> ${producto.activo ? "Activo" : "Inactivo"}</p>

                            <div class="mt-2 d-flex gap-2">

                                <a href="/admin/productos/editar/${producto.id}?pagina=${paginaActual}&categoria=${categoria}"
                                   class="btn btn-warning btn-sm">
                                    Editar
                                </a>

                                ${
                                    producto.activo
                                    ? `<button class="btn btn-danger btn-sm"
                                        onclick="abrirModal('eliminar', ${producto.id}, '${producto.nombre}')">
                                        Eliminar
                                    </button>`
                                    : `<button class="btn btn-success btn-sm"
                                        onclick="abrirModal('activar', ${producto.id}, '${producto.nombre}')">
                                        Activar
                                    </button>`
                                }

                            </div>

                        </div>

                    </div>

                </div>
            `;
        });

        renderPaginacion(resultado.totalPaginas);

    } catch (error) {

        console.error(error);
        document.getElementById("contenedorProductos").innerHTML =
            "<p>Error al cargar productos</p>";
    }
}

function renderPaginacion(totalPaginas) {

    const paginacion = document.getElementById("paginacion");
    paginacion.innerHTML = "";

    const categoria = document.getElementById("filtroCategoria").value;

    if (paginaActual > 1) {
        paginacion.innerHTML += `
            <li class="page-item">
                <button class="page-link" onclick="cargarProductos(${paginaActual - 1})">
                    Anterior
                </button>
            </li>
        `;
    }

    for (let i = 1; i <= totalPaginas; i++) {

        paginacion.innerHTML += `
            <li class="page-item ${i === paginaActual ? "active" : ""}">
                <button class="page-link" onclick="cargarProductos(${i})">
                    ${i}
                </button>
            </li>
        `;
    }

    if (paginaActual < totalPaginas) {
        paginacion.innerHTML += `
            <li class="page-item">
                <button class="page-link" onclick="cargarProductos(${paginaActual + 1})">
                    Siguiente
                </button>
            </li>
        `;
    }
}

document.getElementById("filtroCategoria")
    .addEventListener("change", () => cargarProductos(1));

function abrirModal(accion, id, nombre) {

    const modalTexto = document.getElementById("modalTexto");
    const form = document.getElementById("formAccion");

    const categoria = document.getElementById("filtroCategoria").value;

    if (accion === "eliminar") {

        modalTexto.innerText = `¿Seguro que querés eliminar "${nombre}"?`;
        form.action = `/admin/productos/eliminar/${id}?pagina=${paginaActual}&categoria=${categoria}`;

        form.querySelector("button").className = "btn btn-danger";
        form.querySelector("button").innerText = "Eliminar";

    } else {

        modalTexto.innerText = `¿Seguro que querés activar "${nombre}"?`;
        form.action = `/admin/productos/activar/${id}?pagina=${paginaActual}&categoria=${categoria}`;

        form.querySelector("button").className = "btn btn-success";
        form.querySelector("button").innerText = "Activar";
    }

    new bootstrap.Modal(document.getElementById("modalConfirmar")).show();
}

document.getElementById("formAccion").addEventListener("submit", async function (e) {

    e.preventDefault();

    const form = e.target;

    try {

        await fetch(form.action, { method: "POST" });

        bootstrap.Modal.getInstance(
            document.getElementById("modalConfirmar")
        ).hide();

        cargarProductos(paginaActual);

    } catch (error) {
        console.error(error);
        alert("Error al procesar la acción");
    }
});

cargarProductos(paginaActual);

</script>

</body>
</html>