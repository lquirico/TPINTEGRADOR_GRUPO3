<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Catálogo de Productos</title>

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="./img/favicon.png">


    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet">

    <link
rel="stylesheet"
href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>

<body>

    


    <!-- NAVBAR -->
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark">

    <div class="container d-flex justify-content-between align-items-center">

        <a class="navbar-brand d-flex align-items-center" href="#">

            <img
                src="/img/bookflix_logo.png"
                alt="Logo"
                width="40"
                class="me-2">

            Bookflix - Tienda de libros y peliculas by Colomer & Quirico

        </a>
            <div class="mb-3">

                <a
                    href="/productos/categorias"
                    class="btn btn-outline-secondary">

                    ← Atrás

                </a>

            </div>
        <a href="/carrito" class="btn btn-outline-light position-relative">

            <i class="bi bi-cart3"></i>

            <span
                id="contadorCarrito"
                class="position-absolute badge rounded-pill bg-danger text-white"
                style="
                    top: -8px;
                    right: -8px;
                    min-width: 22px;
                    height: 22px;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    font-size: 0.75rem;
                ">
                0
            </span>

        </a>
    <div 
        id="mensajeCarrito"
        class="alert alert-success text-center d-none position-fixed top-0 start-50 translate-middle-x mt-3 shadow"
        role="alert"
        style="z-index: 9999;">
        Producto agregado al carrito correctamente.

    </div>

    </div>
    </nav>

   <div class="container mt-4">

    <!-- BIENVENIDA -->
    <h1
        id="saludoCliente"
        class="text-center mb-4">

        Bienvenido!

    </h1>

    <!-- TITULO DINAMICO -->

    <h2 class="mb-4 text-center">

        <% if (categoria === "Libro") { %>

            📚 Libros

        <% } else if (categoria === "Pelicula") { %>

            🎬 Películas

        <% } else { %>

            🛍️ Catálogo completo

        <% } %>

    </h2>

    <div class="row">

        <% productos.forEach(producto => { %>

            <div class="col-md-3 mb-4">

                <div class="card h-100 shadow-sm">

                    <img
                        src="/uploads/<%= producto.imagen %>"
                        class="card-img-top"
                        alt="<%= producto.nombre %>">

                    <div class="card-body d-flex flex-column">

                        <h5 class="card-title">
                            <%= producto.nombre %>
                        </h5>

                        <p class="card-text">
                            <%= producto.descripcion %>
                        </p>

                        <p>
                            Género:
                            <strong>
                                <%= producto.genero %>
                            </strong>
                        </p>

                        <p>
                            Precio:
                            <strong>
                                $<%= producto.precio %>
                            </strong>
                        </p>

                        <button
                            type="button"
                            class="btn btn-success mt-auto btnAgregarCarrito"
                            data-id="<%= producto.id %>"
                            data-nombre="<%= producto.nombre %>"
                            data-precio="<%= producto.precio %>"
                            data-imagen="<%= producto.imagen %>"
                            data-categoria="<%= producto.categoria %>"
                            data-genero="<%= producto.genero %>">

                            Agregar al carrito

                        </button>

                    </div>

                </div>

            </div>

        <% }) %>

    </div>

    <!-- PAGINACION -->

    <nav class="mt-4">

        <ul class="pagination justify-content-center">

            <% if (paginaActual > 1) { %>

                <li class="page-item">

                    <a
                        class="page-link"
                        href="/productos/catalogo?categoria=<%= categoria %>&pagina=<%= paginaActual - 1 %>">

                        Anterior

                    </a>

                </li>

            <% } %>

            <% for(let i = 1; i <= totalPaginas; i++) { %>

                <li class="page-item <%= i === paginaActual ? 'active' : '' %>">

                    <a
                        class="page-link"
                        href="/productos/catalogo?categoria=<%= categoria %>&pagina=<%= i %>">

                        <%= i %>

                    </a>

                </li>

            <% } %>

            <% if (paginaActual < totalPaginas) { %>

                <li class="page-item">

                    <a
                        class="page-link"
                        href="/productos/catalogo?categoria=<%= categoria %>&pagina=<%= paginaActual + 1 %>">

                        Siguiente

                    </a>

                </li>

            <% } %>

        </ul>

    </nav>

</div>
<script src="/js/carrito.js"></script> <!--con esto, el navegador carga el archivo-->
<script>
    const nombreCliente =
        localStorage.getItem("nombreCliente");
    if(nombreCliente){
        document.getElementById(
            "saludoCliente"
        ).textContent = `Bienvenido, ${nombreCliente}!`;
    }
</script>
</body>
</html>