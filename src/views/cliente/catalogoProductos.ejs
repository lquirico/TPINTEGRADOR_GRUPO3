<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Catálogo de Productos</title>

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="./img/favicon.png">


    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet">

    <link
rel="stylesheet"
href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>

<body>

    


    <!-- NAVBAR -->
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark">

    <div class="container d-flex justify-content-between align-items-center">

        <a class="navbar-brand d-flex align-items-center" href="#">

            <img
                src="/img/bookflix_logo.png"
                alt="Logo"
                width="40"
                class="me-2">

            Bookflix - Tienda de libros y películas

        </a>

        <a href="/carrito" class="btn btn-outline-light position-relative">

            <i class="bi bi-cart3"></i>

            <span
                id="contadorCarrito"
                class="position-absolute badge rounded-pill bg-danger text-white"
                style="
                    top: -8px;
                    right: -8px;
                    min-width: 22px;
                    height: 22px;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    font-size: 0.75rem;
                ">
                0
            </span>

        </a>

    </div>
    </nav>

    <div class="container mt-4">

        <!-- BIENVENIDA -->
        <h1 
            id="saludoCliente"
            class="text-center mb-4">
            Bienvenido!
        </h1>

         <!-- ================== 
        <p class="text-center">
            Total productos: <%= productos.length %>
        </p>
            <% productos.forEach(producto => { %>
            <p>
                <%= producto.nombre %> -
                <%= producto.categoria %>
            </p>
        <% }) %>
          =================== -->

        <!-- ==================
             SECCIÓN LIBROS
        =================== -->

        <h2 class="mb-3">
            Libros
        </h2>

        <div class="row">

            <% productos.forEach(producto => { %>

                <% if (producto.categoria && producto.categoria.toLowerCase() === "libro") { %>

                    <div class="col-md-4 mb-4">

                        <div class="card h-100">

                            <img
                                src="/uploads/<%= producto.imagen %>"
                                class="card-img-top"
                                alt="<%= producto.nombre %>">

                            <div class="card-body">

                                <h5 class="card-title">
                                    <%= producto.nombre %>
                                </h5>

                                <p class="card-text">
                                    <%= producto.descripcion %>
                                </p>

                                <p>
                                    Género:
                                    <strong>
                                        <%= producto.genero %>
                                    </strong>
                                </p>

                                <p>
                                    Precio:
                                    <strong>
                                        $<%= producto.precio %>
                                    </strong>
                                </p>

                                <button
                                type="button"
                                class="btn btn-success btnAgregarCarrito"
                                data-id="<%= producto.id %>"
                                data-nombre="<%= producto.nombre %>"
                                data-precio="<%= producto.precio %>"
                                data-imagen="<%= producto.imagen %>"
                                data-categoria="<%= producto.categoria %>"
                                data-genero="<%= producto.genero %>"> <!--"data" se utiliza para transportar toda la información del producto. 
                                                                        JavaScript ya tiene toda la info y no es necesario consultar nuevamente a la base -->
                                    Agregar al carrito
                                </button>
                            </div>

                        </div>

                    </div>

                <% } %>

            <% }) %>

        </div>

        <!-- ==================
             SECCIÓN PELÍCULAS
        =================== -->

        <h2 class="mt-5 mb-3">
            Peliculas
        </h2>

        <div class="row">

            <% productos.forEach(producto => { %>

                <% if (producto.categoria && producto.categoria.toLowerCase() === "pelicula") { %>

                    <div class="col-md-4 mb-4">

                        <div class="card h-100">

                            <img
                                src="/uploads/<%= producto.imagen %>"
                                class="card-img-top"
                                alt="<%= producto.nombre %>">

                            <div class="card-body">

                                <h5 class="card-title">
                                    <%= producto.nombre %>
                                </h5>

                                <p class="card-text">
                                    <%= producto.descripcion %>
                                </p>

                                <p>
                                    Género:
                                    <strong>
                                        <%= producto.genero %>
                                    </strong>
                                </p>

                                <p>
                                    Precio:
                                    <strong>
                                        $<%= producto.precio %>
                                    </strong>
                                </p>

                                <button
                                type="button"
                                class="btn btn-success btnAgregarCarrito"
                                data-id="<%= producto.id %>"
                                data-nombre="<%= producto.nombre %>"
                                data-precio="<%= producto.precio %>"
                                data-imagen="<%= producto.imagen %>"
                                data-categoria="<%= producto.categoria %>"
                                data-genero="<%= producto.genero %>"> <!--"data" se utiliza para transportar toda la información del producto. 
                                                                        JavaScript ya tiene toda la info y no es necesario consultar nuevamente a la base -->
                                    Agregar al carrito
                                </button>

                            </div>

                        </div>

                    </div>

                <% } %>

            <% }) %>

        </div>

    </div>
<script src="/js/carrito.js"></script> <!--con esto, el navegador carga el archivo-->
<script>
    const nombreCliente =
        localStorage.getItem("nombreCliente");
    if(nombreCliente){
        document.getElementById(
            "saludoCliente"
        ).textContent = `Bienvenido, ${nombreCliente}!`;
    }
</script>
</body>
</html>