<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Bookflix - Tienda de libros y películas</title>

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/img/favicon.png">

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body>
     <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">

        <div class="container">
            

            <a class="navbar-brand d-flex align-items-center" href="#">
                <img src="/img/bookflix_logo.png"
                     alt="Logo"
                     width="40"
                     class="me-2">

                Bookflix - Tienda de libros y películas
            </a>

            

        </div>

    </nav>
    <div class="container mt-5">
        <div class="card shadow text-center">
            <div class="card-body p-5">
                <h1 class="mb-3">
                    Compra realizada correctamente
                </h1>
                <p>
                    Su ticket se generó exitosamente.
                </p>
                <p class="text-muted mb-4">
                    Gracias por comprar en Bookflix!
                </p>
                <a href="/" class="btn btn-dark">
                    Volver al inicio
                </a>
                <a 
                    id="btnDescargarTicket"
                    href="#"
                    target="_blank"
                    class="btn btn-dark mt-3">
                    Descargar ticket PDF

                </a>

            </div>

        </div>

    </div>
    <script>
        const ticketPDF = localStorage.getItem("ultimoTicketPdf");
        const botonTicket = document.getElementById("btnDescargarTicket");

        if(ticketPDF){
            botonTicket.href = ticketPDF; //si el pdf existe, el botón queda visible

        }
        else{
            botonTicket.style.display = "none"; //si el pdf no existe, el botón se oculta
        }
    </script>
    
</body>
</html>