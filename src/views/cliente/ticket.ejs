<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <title>Ticket de Compra</title>

    <style>

        body{
            font-family: Arial, sans-serif;
            padding: 30px;
        }

        h1{
            text-align: center;
        }

        table{
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }

        th,
        td{
            border: 1px solid #ccc;
            padding: 10px;
            text-align: left;
        }

        .total{
            margin-top: 20px;
            text-align: right;
            font-size: 20px;
            font-weight: bold;
        }

    </style>

</head>

<body>

    <h1>BOOKFLIX</h1>

    <p>
        Cliente:
        <strong><%= venta.cliente_nombre %></strong>
    </p>

    <p>
        Fecha:
        <strong>
            <%= venta.fecha.toLocaleDateString() %>
        </strong>
    </p>

    <table>

        <thead>

            <tr>
                <th>Producto</th>
                <th>Cantidad</th>
            </tr>

        </thead>

        <tbody>

            <% productos.forEach(producto => { %>

                <tr>

                    <td>
                        <%= producto.nombre %>
                    </td>

                    <td>
                        <%= producto.Venta_productos.cantidad %>
                    </td>

                </tr>

            <% }) %>

        </tbody>

    </table>

    <div class="total">

        Total: $<%= venta.total %>

    </div>

</body>

</html>