<!DOCTYPE html>
<html>
<head>
    <title>Login</title>
</head>
<body>

    <h1>Iniciar Sesión</h1>

    <form action="/login" method="POST">

        <div>
            <label>Email</label>
            <input
                type="email"
                name="email"
                required>
        </div>

        <br>

        <div>
            <label>Contraseña</label>
            <input
                type="password"
                name="password"
                required>
        </div>

        <br>

        <button type="submit">
            Ingresar
        </button>

    </form>

</body>
</html>