<!DOCTYPE html>
<html>

<head>
    <title>Nuevo Producto</title>
</head>

<body>

    <h1>Nuevo Producto</h1>

    <form action="/productos/nuevo" method="POST">

        <div>
            <label>Nombre</label>
            <input
                type="text"
                name="nombre"
                required>
        </div>

        <br>

        <div>
            <label>Descripción</label>
            <textarea
                name="descripcion"
                required></textarea>
        </div>

        <br>

        <div>
            <label>Precio</label>
            <input
                type="number"
                step="0.01"
                name="precio"
                required>
        </div>

        <br>

        <div>
            <label>Imagen</label>
            <input
                type="text"
                name="imagen"
                required>
        </div>

        <br>

        <div>
            <label>Categoría</label>

            <select name="categoria">

                <option value="Libro">
                    Libro
                </option>

                <option value="Película">
                    Película
                </option>

            </select>
        </div>

        <br>

        <div>
            <label>Género</label>
            <input
                type="text"
                name="genero"
                required>
        </div>

        <br>

        <button type="submit">
            Guardar Producto
        </button>

    </form>

</body>

</html>