<!DOCTYPE html>
<html>

<head>
    <title>Nuevo Producto</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css"
        rel="stylesheet">
    <link rel="stylesheet" href="/css/estilos.css">
</head>

<body>

    <a href="/productos">
        ← Volver al listado
    </a>

    <hr>

    <h1>Nuevo Producto</h1>

    <form
        id="formNuevoProducto"
        action="/productos/nuevo"
        method="POST"
        enctype="multipart/form-data">

        <div>
            <label>Nombre</label>
            <input
                type="text"
                name="nombre"
                required>
        </div>

        <br>

        <div>
            <label>Descripcion</label>
            <textarea
                name="descripcion"
                required></textarea>
        </div>

        <br>

        <div>
            <label>Precio</label>
            <input
                type="number"
                step="0.01"
                name="precio"
                required>
        </div>

        <br>

        <div>
            <label>Imagen</label>
            <input
                type="file"
                name="imagen"
                required>
        </div>

        <br>

        <div>
            <label>Categoria</label>

            <select name="categoria">

                <option value="Libro">
                    Libro
                </option>

                <option value="Película">
                    Pelicula
                </option>

            </select>

        </div>

        <br>

        <div>
            <label>Genero</label>

            <input
                type="text"
                name="genero"
                required>

        </div>

        <br>

        <button
            type="button"
            data-bs-toggle="modal"
            data-bs-target="#modalCrear">

            Guardar Producto

        </button>

    </form>

    <!-- MODAL PARA CONFIRMAR CREACION -->

    <div
        class="modal fade"
        id="modalCrear"
        tabindex="-1">

        <div class="modal-dialog">

            <div class="modal-content">

                <div class="modal-header">

                    <h5 class="modal-title">
                        Confirmar creacion
                    </h5>

                </div>

                <div class="modal-body">

                    ¿Esta seguro de que desea crear este producto?

                </div>

                <div class="modal-footer">

                    <button
                        type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">

                        No

                    </button>

                    <button
                        type="button"
                        class="btn btn-success"
                        onclick="enviarFormulario()">

                        Si

                    </button>

                </div>

            </div>

        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>

    <script>

        function enviarFormulario() {

            document
                .getElementById("formNuevoProducto")
                .submit();

        }

    </script>

</body>

</html>