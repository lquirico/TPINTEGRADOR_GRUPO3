<!DOCTYPE html>
<html>
<head>
    <title>Productos</title>
    <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css"
    rel="stylesheet">
    <link rel="stylesheet" href="/css/estilos.css">
</head>
<body>
    <a href="/logout">
    Cerrar sesión
</a>
|
    <h1>Listado de Productos</h1>

<a href="/productos/nuevo">
    Nuevo Producto
</a>


<hr>

    <% productos.forEach(producto => { %>

        <div class="producto-card">
            <h3><%= producto.nombre %></h3>
            <a href="/productos/editar/<%= producto.id %>">
                    Editar
            </a>
            <img
                src="/uploads/<%= producto.imagen %>"
                alt="<%= producto.nombre %>"
                class="producto-imagen">

            <br><br>

            <p>
                Categoría: <%= producto.categoria %>
            </p>
            <p>
                Descripción: <%= producto.descripcion %>
            </p>

            <p>
                Género: <%= producto.genero %>
            </p>

            <p>
                Precio: $<%= producto.precio %>
            </p>

            <p>
                Estado: 
                 <span class="<%= producto.activo ? 'estado-activo' : 'estado-inactivo' %>">
                        <%= producto.activo ? "Activo" : "Inactivo" %>
                 </span>
            </p>

            <hr>
            <% if(producto.activo) { %>
<button
    type="button"
    data-bs-toggle="modal"
    data-bs-target="#modalEliminar<%= producto.id %>">

    Eliminar

</button>
  <!-- MODAL PARA CONFIRMAR ELIMINACION -->


<div
    class="modal fade"
    id="modalEliminar<%= producto.id %>"
    tabindex="-1">

    <div class="modal-dialog">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">
                    Confirmar eliminacion
                </h5>

            </div>

            <div class="modal-body">

                ¿Esta seguro de eliminar
                "<%= producto.nombre %>"?

            </div>

            <div class="modal-footer">

                <button
                    type="button"
                    class="btn btn-secondary"
                    data-bs-dismiss="modal">

                    No

                </button>

                <form
                    action="/productos/eliminar/<%= producto.id %>"
                    method="POST">

                    <button
                        type="submit"
                        class="btn btn-danger">

                        Si

                    </button>

                </form>

            </div>

        </div>

    </div>

</div>

            <% } else { %>

    <button
        type="button"
        data-bs-toggle="modal"
        data-bs-target="#modalActivar<%= producto.id %>">

        Activar

    </button>

      <!-- MODAL PARA CONFIRMAR ACTIVACION -->
<div
    class="modal fade"
    id="modalActivar<%= producto.id %>"
    tabindex="-1">

    <div class="modal-dialog">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">
                    Confirmar activacion
                </h5>

            </div>

            <div class="modal-body">

                ¿Esta seguro de activar
                "<%= producto.nombre %>"?

            </div>
  <!-- MODAL PARA CONFIRMAR ACTIVACION -->
            <div class="modal-footer">

                <button
                    type="button"
                    class="btn btn-secondary"
                    data-bs-dismiss="modal">

                    No

                </button>

                <form
                    action="/productos/activar/<%= producto.id %>"
                    method="POST">

                    <button
                        type="submit"
                        class="btn btn-success">

                        Si

                    </button>

                </form>

            </div>

        </div>

    </div>

</div>

            <% } %>

        </div>

    <% }) %>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>