<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Catálogo de Productos</title>

    <!--Boostrap-->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet">


    
</head>
<body>
    <!--NAVBAR-->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <!--nombre de la web-->
            <a class="navbar-brand" href="#">
                 <!--Logo-->
                <img src="./img/logo.png" 
                alt="Logo" 
                width="40"
                class="me-2">


                <!--Nombre de la web-->
                TP INTEGRADOR GRUPO 3


            </a>

        </div>
    </nav>

    <div class="container mt-4">
        
        <!--============
        Bienvenida al cliente (el nombre se obtiene de la sesión)
        =============-->

        <h1 class="text-center mb-4">
            Bienvenido, <%= nombreCliente %>!

        </h1>

        <!--==================
        SECCIÓN LIBROS
        ==================-->
        <h2 class="mb-3"> 
            Libros
        </h2>

        <div class="row">
           
           
            <% productos.forEach(producto => { %>  <!--Recorre la lista de productos-->
            <% if(producto.categoria === "libro") { %> <!--Filtra por categoría "libro"-->
            <div class="col-md-4 mb-4">
                <div class="card h-100">
                    <!--Imagen del producto-->
                    <img
                    src="<%= producto.imagen %>"
                    class="card-img-top"
                    alt="<%= producto.nombre %>">
                <div class="card-body">
                    <h5 class="card-title">
                        <%= producto.nombre %>
                    </h5>
                    <p class="card-text">
                        <%= producto.descripcion %>
                    </p>
                    <p>
                        Género: 
                        <strong>
                            <%= producto.genero %>
                        </strong>
                    </p>

                    <p>
                        Precio:
                        <strong>
                            $<%= producto.precio %>
                        </strong>
                    </p>

                    <!--Agregar al carrito-->
                    <form 
                    action="/carrito/agregar/<%= producto.id %>"
                    method="POST">

                    <button
                    type="submit"
                    class="btn btn-success">

                        Agregar al carrito

                    </button>

                    </form>

                    
                </div>
                </div>

                </div>

            <% } %>

            <% }) %>

        </div>
        <!--===============
        SECCIÓN PELÍCULAS
        ===================-->

        <h2 class="mt-5 mb-3">
            Películas 

        </h2>

        <div class="row">
            <% productos.forEach(producto => { %> <!--Recorre la lista de productos-->
            <% if(producto.categoria === "pelicula"){ %> <!--Filtra por categoría "pelicula"-->
                <div class="col-md-4 mb-4">

                    <div class="card h-100">

                        <img 
                        src="<%= producto.imagen %>"
                        class="card-img-top"
                        alt="<%= producto.nombre %>">

                        <div class="card-body">
                            <h5 class="card-title">
                                <%= producto.nombre %> <!--Se muestra la info del producto (ejs lo reemplaza x el valor real)-->

                            </h5>
                            <p class="card-text">
                                <%= producto.descripcion %>
                            </p>
                            <p>
                                Género:
                                <strong>
                                    <%= producto.genero %>
                                </strong>
                            </p>
                            <p>
                                Precio:
                                <strong>
                                    $<%= producto.precio %>
                                </strong>
                            </p>
                            <form action="/carrito/agregar/<%=producto.id %>" 
                                method="POST"> <!--Formulario para agregar al carrito-->
                                                <!--Si el producto tiene id 1 va a ser: "/carrito/agregar/1"-->

                                <button
                                type="submit"
                                class="btn btn-success">

                                    Agregar al carrito

                                </button> <!--Se envía el producto al carrito y se redirecciona al form para ver el carrito-->
                            </form> 
                        </div> 
                    </div> 
                </div> 
            <% } %> 
                
        <% }) %> 
    
    </div> 
</div>

</body>
</html>