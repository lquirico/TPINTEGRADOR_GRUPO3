<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Bookflix - Tienda de libros y películas</title>

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="./img/favicon.png">

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body>

    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">

        <div class="container">
            

            <a class="navbar-brand d-flex align-items-center" href="#">
                <img src="./img/bookflix_logo.png"
                     alt="Logo"
                     width="40"
                     class="me-2">

                Bookflix - Tienda de libros y películas
            </a>

            <button
                class="navbar-toggler"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#menu">

                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="menu">

                <ul class="navbar-nav ms-auto">

                    <li class="nav-item">

                    </li>

                </ul>

            </div>

        </div>

    </nav>

    <!-- CONTENIDO PRINCIPAL -->
    <main class="container">

        <div class="row justify-content-center mt-5">

            <div class="col-md-8 col-lg-6">

                <!-- Card principal -->
                <div class="card shadow-lg border-0 rounded-4">

                    <div class="card-body p-5">

                        <h1 class="fw-bold text-center mb-3">
                            Bienvenido
                        </h1>

                        <p class="text-muted text-center mb-5">
                            Descubrí una amplia colección de libros y películas.
                        </p>

                        <!-- CLIENTE -->
                        <section class="mb-5">

                            <h4 class="fw-semibold mb-3">
                                Si usted es cliente:
                            </h4>

                            <form
                                id="formBienvenida"
                                action="/productos/catalogo"
                                method="GET">

                                <div class="mb-3">
                                    <input
                                        type="text"
                                        id="nombreCliente"
                                        name="nombreCliente"
                                        class="form-control form-control-lg"
                                        placeholder="Ingrese su nombre"
                                        required>
                                </div>

                                <button
                                    type="submit"
                                    class="btn btn-dark btn-lg w-100">

                                    Ingresar al catálogo

                                </button>

                            </form>

                        </section>

                        <hr class="my-4">

                        <!-- ADMINISTRADOR -->
                        <section>

                            <h4 class="fw-semibold mb-3">
                                Si usted es administrador:
                            </h4>

                            <form
                                action="/login"
                                method="POST">

                                <div class="mb-3">
                                    <input
                                        type="email"
                                        name="email"
                                        class="form-control form-control-lg"
                                        placeholder="Correo electrónico"
                                        required>
                                </div>

                                <div class="mb-3">
                                    <input
                                        type="password"
                                        name="password"
                                        class="form-control form-control-lg"
                                        placeholder="Contraseña"
                                        required>
                                </div>

                                <button
                                    type="submit"
                                    class="btn btn-dark btn-lg w-100">

                                    Iniciar sesión

                                </button>

                            </form>
                            <div class="text-center mt-3">

                                <p>
                                    ¿No tenés cuenta?
                                </p>

                                <a
                                    href="/registro"
                                    class="btn btn-outline-success">

                                    Registrarse

                                </a>

                            </div>

                        </section>

                    </div>

                </div>

            </div>

        </div>

    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>